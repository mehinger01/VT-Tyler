<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="description" content="Tyler Session 9 system tune-up, finals extension, and ownership transfer.">
<title>Session 9: Stress-Test → Gaps → Extend → Restart Plan → Close | Tyler OS</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;600;700;800&family=Playfair+Display:wght@700&display=swap">
<style>
:root{--navy:#20365f;--blue-soft:#eef4ff;--paper:#f8fafc;--line:#d9e2ef;--muted:#617186;--ink:#26344a;--green:#1b6b48;--amber:#8a5a00}
*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:"DM Sans",sans-serif}
.container{max-width:1080px;margin:auto;padding:0 20px}.lesson-hero{padding:58px 0 34px;background:linear-gradient(180deg,#f6f8ff,var(--paper))}
.eyebrow{font-size:.78rem;text-transform:uppercase;letter-spacing:.1em;font-weight:800;color:#56709b}
h1,h2,h3{color:var(--navy)}h1{font-size:clamp(2.2rem,5vw,4rem);line-height:1.05;margin:.15em 0}.hero-copy{max-width:760px;font-size:1.08rem;color:var(--muted)}
.lesson-shell{max-width:1080px;margin:0 auto;padding:28px 20px 84px}.flow{position:sticky;top:10px;z-index:5;display:grid;grid-template-columns:repeat(5,1fr);gap:8px;padding:10px;background:rgba(255,255,255,.96);border:1px solid var(--line);border-radius:18px;box-shadow:0 8px 24px rgba(32,54,95,.08);margin-bottom:26px}
.flow a{text-align:center;text-decoration:none;padding:10px 8px;border-radius:12px;font-weight:800;color:var(--muted);font-size:.85rem}.flow a:hover{background:var(--blue-soft);color:var(--navy)}
.stage{scroll-margin-top:100px;background:#fff;border:1px solid var(--line);border-radius:22px;padding:clamp(22px,4vw,38px);margin:0 0 24px;box-shadow:0 10px 28px rgba(32,54,95,.055)}
.stage-head{display:flex;gap:15px;align-items:flex-start;margin-bottom:18px}.stage-num{flex:0 0 42px;height:42px;border-radius:50%;display:grid;place-items:center;background:var(--navy);color:white;font-weight:800}
.quick-fields,.note-grid,.prompt-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.field{margin:14px 0}.field label{display:block;font-weight:800;color:var(--navy);margin-bottom:7px}.field textarea,.field input[type=text]{width:100%;border:1px solid #ccd7e6;border-radius:12px;padding:12px;font:inherit;background:#fff}.field textarea{min-height:80px;resize:vertical}
.tip{padding:16px 18px;border-left:4px solid var(--navy);background:var(--blue-soft);border-radius:10px;margin:18px 0}
.recall-list{display:grid;gap:14px}
.recall-item{padding:16px 18px;border:1px solid var(--line);border-radius:16px;background:var(--paper)}
.recall-item label{display:block;font-weight:800;color:var(--navy);margin-bottom:8px}
.recall-item textarea{width:100%;min-height:70px;border:1px solid #ccd7e6;border-radius:10px;padding:10px;font:inherit;background:#fff}
.confidence-row{display:flex;gap:6px;margin-top:10px;align-items:center}
.confidence-row span.cl{font-size:.8rem;color:var(--muted);margin-right:6px}
.conf-btn{border:1px solid #cbd7e7;background:#fff;border-radius:8px;width:30px;height:30px;font-weight:800;cursor:pointer;color:var(--navy)}
.conf-btn.selected{background:var(--navy);color:#fff;border-color:var(--navy)}
.reveal{display:none;margin-top:12px;padding:12px 14px;border-radius:10px;background:#fff;border:1px dashed #a9bad0;font-size:.92rem;color:var(--muted)}
.button{border:0;border-radius:999px;padding:10px 15px;font-weight:800;cursor:pointer;text-decoration:none;display:inline-block}.primary{background:var(--navy);color:#fff}.secondary{background:#fff;color:var(--navy);border:1px solid #cbd7e7}
.col-table{width:100%;border-collapse:collapse;margin:14px 0;font-size:.88rem}
.col-table th,.col-table td{border:1px solid var(--line);padding:8px 10px;text-align:left}
.col-table th{background:var(--navy);color:#fff}
.col-table td.formula{font-family:"JetBrains Mono",monospace;font-size:.8rem;color:var(--navy)}
.step-list{display:grid;gap:12px}
.step-item{padding:14px 16px;border:1px solid var(--line);border-radius:14px;background:var(--paper);display:flex;gap:14px;align-items:flex-start}
.step-num{flex:0 0 30px;height:30px;border-radius:50%;background:var(--navy);color:#fff;display:grid;place-items:center;font-weight:800;font-size:.85rem}
.space-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.space-card{padding:16px;border:1px solid var(--line);border-radius:15px;background:var(--paper)}
.close-card{padding:22px;border-radius:18px;background:linear-gradient(135deg,#eef4ff,#f8fafc);border:1px solid var(--line)}
.close-card .retrieval-question{font-size:1.2rem;font-weight:800;color:var(--navy)}
.save-status{font-size:.9rem;color:var(--muted);text-align:right}
@media(max-width:760px){.flow{position:static;grid-template-columns:1fr 1fr}.flow a:last-child{grid-column:1/-1}.quick-fields,.note-grid,.prompt-grid,.space-grid{grid-template-columns:1fr}.lesson-shell{padding-inline:13px}}
</style>
</head>
<body>
<header class="lesson-hero"><div class="container">
<p class="eyebrow">Session 9 · System Tune-Up + Finals Extension</p>
<h1>Stress-Test → Gaps → Extend → Restart Plan → Close</h1>
<p class="hero-copy">This is the last built session before real classes start. Today isn't new content — it's making sure the system survives without a coach in the room, and extending the spacing schedule so it's ready for finals.</p>
</div></header>
<main class="lesson-shell">
<nav class="flow"><a href="#stress-test">STRESS-TEST</a><a href="#gaps">GAPS</a><a href="#extend">EXTEND</a><a href="#restart">RESTART PLAN</a><a href="#close">CLOSE</a></nav>

<section class="stage" id="stress-test"><div class="stage-head"><span class="stage-num">1</span><div><p class="eyebrow">No prompting</p><h2>Explain the system, cold</h2><p>Write each of these in your own words, without looking anything up. This is a check, not a quiz — the point is finding out what's actually automatic versus what still needs a reminder.</p></div></div>

<div class="recall-list" id="recallList">
<div class="recall-item"><label for="r1">The before / during / after class cycle — what happens in each phase?</label><textarea id="r1" data-save></textarea>
<div class="confidence-row"><span class="cl">Confidence:</span><div class="conf-group" data-item="r1"></div></div>
<button class="button secondary" style="margin-top:10px" data-reveal="ref1">Check reference</button><div class="reveal" id="ref1">Before: cold attempt, then 3-pass + chunking. During: fill gaps live. After: pull it together and rewrite/synthesize.</div></div>

<div class="recall-item"><label for="r2">The 3-pass reading method — what happens on each pass?</label><textarea id="r2" data-save></textarea>
<div class="confidence-row"><span class="cl">Confidence:</span><div class="conf-group" data-item="r2"></div></div>
<button class="button secondary" style="margin-top:10px" data-reveal="ref2">Check reference</button><div class="reveal" id="ref2">Pass 1: intro, topic sentences, conclusion — summarize in your own words. Pass 2 and 3 go progressively deeper into the chunked material.</div></div>

<div class="recall-item"><label for="r3">Read → Note → Retrieve → Repair → Space — what does each step actually do?</label><textarea id="r3" data-save></textarea>
<div class="confidence-row"><span class="cl">Confidence:</span><div class="conf-group" data-item="r3"></div></div>
<button class="button secondary" style="margin-top:10px" data-reveal="ref3">Check reference</button><div class="reveal" id="ref3">Read strategically, note only what's worth keeping, retrieve without looking, repair only what retrieval exposed as weak, then space that retrieval out over days instead of one long review.</div></div>

<div class="recall-item"><label for="r4">The spacing schedule in the Assignment Tracker — how do the review dates get calculated?</label><textarea id="r4" data-save></textarea>
<div class="confidence-row"><span class="cl">Confidence:</span><div class="conf-group" data-item="r4"></div></div>
<button class="button secondary" style="margin-top:10px" data-reveal="ref4">Check reference</button><div class="reveal" id="ref4">Date Learned plus 1, 3, 7, and 14 days, with the Review Status column flagging amber when a review date has passed and isn't checked off.</div></div>

<div class="recall-item"><label for="r5">The 3+3 morning routine and the 50/5 work block rule — what are they for?</label><textarea id="r5" data-save></textarea>
<div class="confidence-row"><span class="cl">Confidence:</span><div class="conf-group" data-item="r5"></div></div>
<button class="button secondary" style="margin-top:10px" data-reveal="ref5">Check reference</button><div class="reveal" id="ref5">3+3: three must-dos, then three gratitudes, to start the day with direction instead of drift. 50/5: 50 minutes focused work, 5 minutes moving, to protect focus without burning out.</div></div>
</div>
</section>

<section class="stage" id="gaps"><div class="stage-head"><span class="stage-num">2</span><div><p class="eyebrow">Be honest, not thorough</p><h2>Name the real gap</h2><p>Every system has a weak point. Finding it now, while there's still support in the room, is more useful than finding it in week 6 alone.</p></div></div>
<div class="quick-fields">
<div class="field"><label for="g-weak">Which piece from Stage 1 are you least confident survives a genuinely busy week?</label><textarea id="g-weak" data-save placeholder="Honestly, probably..."></textarea></div>
<div class="field"><label for="g-tell">What's the early tell that you're starting to fall off the system — before it's a real problem?</label><textarea id="g-tell" data-save placeholder="I'll know I'm slipping when..."></textarea></div>
</div>
</section>

<section class="stage" id="extend"><div class="stage-head"><span class="stage-num">3</span><div><p class="eyebrow">Same skills, new target</p><h2>Extend the tracker for finals</h2><p>Real exam dates probably aren't set yet, so this is a template — built and tested now with a placeholder date, ready to use for real once the registrar posts the finals schedule. No new Sheets concepts: same IF logic and conditional formatting from Sessions 5–8, pointed at a new problem.</p></div></div>

<a class="button primary" href="https://docs.google.com/spreadsheets/d/1E_pNHhapjs24wuuQJczNrc_v7gSXxpSW/edit" target="_blank" rel="noopener">Open the College Command Center →</a>

<h3 style="margin-top:24px">Columns to add (M–P), next to the spacing structure from Session 8</h3>
<table class="col-table">
<tr><th>Column</th><th>Header</th><th>Content</th></tr>
<tr><td>M</td><td>Exam Date</td><td class="formula">Real date, M/d/yyyy — placeholder for now</td></tr>
<tr><td>N</td><td>Days Until Exam</td><td class="formula">=M4-TODAY()</td></tr>
<tr><td>O</td><td>Review Tier</td><td class="formula">=IF(N4&gt;14,"Weekly",IF(N4&gt;7,"Every 3 Days","Daily"))</td></tr>
<tr><td>P</td><td>Reviewed Today?</td><td class="formula">Checkbox — conditional format amber if Review Tier = "Daily" and P is unchecked</td></tr>
</table>

<h3>Build order</h3>
<div class="step-list">
<div class="step-item"><span class="step-num">1</span><div>Add the four header labels in row 3, columns M–P, matching the existing blue header style.</div></div>
<div class="step-item"><span class="step-num">2</span><div>Format column M as a date column (M/d/yyyy), same as Due Date and Date Learned.</div></div>
<div class="step-item"><span class="step-num">3</span><div>Enter one test row: pick any class, enter a placeholder exam date roughly 3 weeks out, and confirm N and O calculate correctly.</div></div>
<div class="step-item"><span class="step-num">4</span><div>Add the checkbox validation to column P, then the conditional formatting rule.</div></div>
<div class="step-item"><span class="step-num">5</span><div>Test the rule: temporarily change the placeholder exam date to tomorrow and confirm P turns amber when unchecked. Then reset it back to the placeholder.</div></div>
</div>
<div class="quick-fields">
<div class="field"><label for="e-course">Which class did you use to test the formulas?</label><textarea id="e-course" data-save></textarea></div>
<div class="field"><label for="e-confirm">Did the amber flag trigger correctly when you tested it?</label><textarea id="e-confirm" data-save></textarea></div>
</div>
</section>

<section class="stage" id="restart"><div class="stage-head"><span class="stage-num">4</span><div><p class="eyebrow">For the week it actually lapses</p><h2>Write your own restart plan</h2><p>Every system lapses at some point. The plan isn't preventing that — it's making the restart small enough to actually happen.</p></div></div>
<div class="quick-fields">
<div class="field"><label for="p-first">First concrete action when you notice the tell from Stage 2 — not a plan, one action.</label><textarea id="p-first" data-save placeholder="I open the tracker and..."></textarea></div>
<div class="field"><label for="p-book">At what point would you actually book another session instead of trying to fix it alone?</label><textarea id="p-book" data-save placeholder="If it's been more than..."></textarea></div>
</div>
</section>

<section class="stage" id="close"><div class="stage-head"><span class="stage-num">5</span><div><p class="eyebrow">Ownership transfer</p><h2>Close</h2></div></div>
<div class="close-card">
<p class="retrieval-question">It's November and the tracker's been sitting untouched for two weeks. What's the first thing you do — and at what point would you actually call to book a session instead of muscling through alone?</p>
<textarea class="field" id="close-answer" data-save style="width:100%;min-height:110px;border:1px solid #ccd7e6;border-radius:12px;padding:12px;font:inherit;background:#fff;margin-top:12px" placeholder="Your answer..."></textarea>
</div>
<div class="space-grid" style="margin-top:20px">
<div class="space-card"><label><input id="d1" type="checkbox" data-check> Stress-test completed honestly</label></div>
<div class="space-card"><label><input id="d2" type="checkbox" data-check> Finals columns built and tested</label></div>
<div class="space-card"><label><input id="d3" type="checkbox" data-check> Restart plan written</label></div>
</div>
<p class="save-status" id="saveStatus">Everything saves automatically on this device.</p>
</section>
</main>
<script>
(()=>{const KEY='tylerSession9SystemTuneUpV1';const state=JSON.parse(localStorage.getItem(KEY)||'{}');const save=()=>{localStorage.setItem(KEY,JSON.stringify(state));const s=document.getElementById('saveStatus');if(s){s.textContent='Saved.';clearTimeout(window._sv);window._sv=setTimeout(()=>s.textContent='Everything saves automatically on this device.',900)}};
document.querySelectorAll('[data-save]').forEach(e=>{e.value=state[e.id]||'';e.addEventListener('input',()=>{state[e.id]=e.value;save()})});
document.querySelectorAll('[data-check]').forEach(e=>{e.checked=!!state[e.id];e.addEventListener('change',()=>{state[e.id]=e.checked;save()})});
document.querySelectorAll('.conf-group').forEach(group=>{
  const item=group.dataset.item;
  group.innerHTML=[1,2,3,4,5].map(n=>`<button type="button" class="conf-btn" data-n="${n}">${n}</button>`).join('');
  const key='conf_'+item;
  const cur=state[key];
  group.querySelectorAll('.conf-btn').forEach(b=>{if(+b.dataset.n===cur)b.classList.add('selected');b.addEventListener('click',()=>{group.querySelectorAll('.conf-btn').forEach(x=>x.classList.remove('selected'));b.classList.add('selected');state[key]=+b.dataset.n;save()})});
});
document.querySelectorAll('[data-reveal]').forEach(btn=>{btn.addEventListener('click',()=>{const el=document.getElementById(btn.dataset.reveal);el.style.display=el.style.display==='block'?'none':'block'})});
})();
</script>
</body>
</html>
